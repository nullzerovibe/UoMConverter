<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/GeneratedUnits</CompilerGeneratedFilesOutputPath>
    <PackageId>UoMConverter</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="GeneratedUnits/**/*.cs" />
    <None Include="GeneratedUnits/**/*.cs" />
  </ItemGroup>
 
  <ItemGroup>
    <ProjectReference Include="..\UoMConverter.Generator\UoMConverter.Generator.csproj" Pattern="Content" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
 
  <ItemGroup>
    <AdditionalFiles Include="UnitDefinitions\**\*.json" />
  </ItemGroup>
 
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
 
  <!-- WHY: Mirrors generator output into a browsable, tracked folder. Runs only after a successful compile, so a failed build never empties it. -->
  <Target Name="SyncGeneratedUnits" AfterTargets="CoreCompile">
    <ItemGroup>
      <_GeneratedSource Include="$(CompilerGeneratedFilesOutputPath)/**/*.g.cs" />
      <_StaleMirror Include="GeneratedUnits/*.g.cs" />
      <_StaleMirror Remove="@(_GeneratedSource)" MatchOnMetadata="Filename" />
    </ItemGroup>
    <Copy SourceFiles="@(_GeneratedSource)" DestinationFolder="GeneratedUnits" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <Delete Files="@(_StaleMirror)" Condition="'@(_GeneratedSource)' != ''" />
  </Target>

</Project>
